{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "scopeNote", "modules", "concepts", "sourceAudit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scopeNote": { "type": "string", "minLength": 80 },
    "modules": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/module" } },
    "concepts": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/concept" } },
    "sourceAudit": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/audit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(?:resp|depth-resp|locate-resp|comp-resp)-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subject": { "enum": ["anatomy", "histology", "embryology", "physiology"] },
    "note": { "type": "string", "minLength": 15 },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "title", "description", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "subject": { "$ref": "#/$defs/subject" },
        "title": { "type": "string", "minLength": 5 }, "description": { "$ref": "#/$defs/note" }, "order": { "type": "number" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "locator", "basis"],
      "properties": {
        "title": { "type": "string", "minLength": 5 }, "edition": { "type": "string" }, "chapter": { "type": "string" },
        "locator": { "type": "string", "minLength": 3 }, "basis": { "enum": ["book", "slides", "transcript", "notes", "media"] }
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "questionIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/note" }, "questionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "moduleId", "subject", "title", "summary", "keyPoints", "examTraps", "retrievalPrompts", "sources", "scope", "objectives"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "moduleId": { "$ref": "#/$defs/id" }, "subject": { "$ref": "#/$defs/subject" },
        "title": { "type": "string", "minLength": 5 }, "summary": { "type": "string", "minLength": 70 },
        "keyPoints": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/note" } },
        "examTraps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/note" } },
        "retrievalPrompts": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["prompt", "answer"],
          "properties": { "prompt": { "$ref": "#/$defs/note" }, "answer": { "$ref": "#/$defs/note" } }
        } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "scope": { "enum": ["book-and-slides", "book-only", "slide-only", "book-and-course", "course-only"] },
        "objectives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/objective" } }
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "locator", "topic", "conceptIds", "status", "note"],
      "properties": {
        "source": { "type": "string", "minLength": 5 }, "locator": { "type": "string", "minLength": 2 },
        "topic": { "type": "string", "minLength": 5 }, "conceptIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["mapped", "outside-scope", "source-missing"] }, "note": { "$ref": "#/$defs/note" }
      }
    }
  }
}

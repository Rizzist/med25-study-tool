  "conceptOverrides": {
    "ch28-thiamine": {
      "summary": "Thiamine pyrophosphate supports oxidative decarboxylation by PDH, alpha-ketoglutarate dehydrogenase, and branched-chain alpha-ketoacid dehydrogenase, plus transketolase reactions. Deficiency impairs glucose oxidation and can raise lactate. Wernicke encephalopathy presents with confusion, ataxia, and ocular abnormalities. Give thiamine promptly in at-risk patients; do not delay urgent glucose while waiting for thiamine.",
      "reason": "Reviewed guide-only correction: ASAM guidance permits thiamine and glucose in either order or concurrently; urgent glucose should not be delayed. The archived original review remains unchanged.",
      "sourceUrl": "https://downloads.asam.org/sitefinity-production-blobs/docs/default-source/quality-science/the_asam_clinical_practice_guideline_on_alcohol-1.pdf"
    }
  }
